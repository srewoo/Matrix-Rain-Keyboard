{
  "manifest_version": 3,
  "name": "Digital Rain Keyboard",
  "short_name": "Digital Rain",
  "version": "2.0.1",
  "description": "Falling-code digital rain that follows your typing. Six themes, speed, density and per-site control.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Digital Rain settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "rain.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
